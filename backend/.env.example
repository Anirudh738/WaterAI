# ---- Data source: demo | firebase | esp32
#  demo     = deterministic simulated data (default, clearly labelled)
#  firebase = read the ESP32's data from Firebase Realtime Database (REST)
#  esp32    = the ESP32 POSTs readings straight to /api/readings
DATA_SOURCE=demo
DEVICE_ID=unit-01
DEVICE_NAME=Overhead tank · Block A

# ---- Firebase (only when DATA_SOURCE=firebase)
FIREBASE_DB_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_AUTH=
FIREBASE_LIVE_PATH=/devices/unit-01/live
FIREBASE_HISTORY_PATH=/devices/unit-01/history
FIREBASE_PUMP_PATH=/devices/unit-01/commands/pump

# ---- ESP32 direct ingest (only when DATA_SOURCE=esp32). The device sends header: X-Device-Key
DEVICE_API_KEY=change-me-device-key

# ---- LLM (optional). Leave LLM_API_KEY empty to use the rule-based demo assistant.
LLM_PROVIDER=anthropic        # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5    # e.g. claude-sonnet-5-5, or an OpenAI model name
LLM_BASE_URL=                 # optional, for OpenAI-compatible servers

# ---- Pump control. Empty token = pump API disabled (except simulated demo).
PUMP_CONTROL_TOKEN=

# ---- CORS: * = any origin (fine for local use). Restrict to your dashboard URL when deploying.
CORS_ORIGINS=*
